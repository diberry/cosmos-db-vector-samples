{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Post-editorial validation",
  "description": "Stage 11 combined post-editorial validation result (11-post-editorial-validation.json). Revalidates the selected editorial output against the Stage 9 protected technical contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "inputProvenance",
    "contractCoverage",
    "parity",
    "links",
    "protectedTechnicalDiff",
    "semanticPackageFidelity",
    "idempotence",
    "overallResult",
    "publicationReady",
    "blockingReasons"
  ],
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hash in lowercase hex."
    },
    "validationResult": {
      "type": "string",
      "enum": ["pass", "fail"],
      "description": "Pass or fail result."
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "description": "Run identifier."
    },
    "inputProvenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Verifies that the validated files match the Stage 10 selection.",
      "required": [
        "selectionFile",
        "selectionFileHash",
        "resolvedCandidateRoot",
        "recomputedHashes",
        "provenanceResult"
      ],
      "properties": {
        "selectionFile": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the 10-editorial-output-selection.json file."
        },
        "selectionFileHash": {
          "$ref": "#/definitions/sha256",
          "description": "SHA-256 hash of the selection file."
        },
        "resolvedCandidateRoot": {
          "type": "string",
          "minLength": 1,
          "description": "Resolved absolute path to the candidate root from the selection file."
        },
        "recomputedHashes": {
          "type": "array",
          "description": "Recomputed hashes of each candidate file.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "expectedSha256", "actualSha256", "match"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Path to the candidate file."
              },
              "expectedSha256": {
                "$ref": "#/definitions/sha256",
                "description": "Expected hash from the selection file."
              },
              "actualSha256": {
                "$ref": "#/definitions/sha256",
                "description": "Actual recomputed hash."
              },
              "match": {
                "type": "boolean",
                "description": "Whether expected and actual hashes match."
              }
            }
          }
        },
        "provenanceResult": {
          "$ref": "#/definitions/validationResult",
          "description": "Overall provenance check result."
        }
      }
    },
    "contractCoverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Whether the selected output still covers the Stage 9 contract.",
      "required": ["items", "result"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contractId", "status", "evidence"],
            "properties": {
              "contractId": {
                "type": "string",
                "minLength": 1,
                "description": "Contract item identifier."
              },
              "status": {
                "type": "string",
                "enum": ["covered", "missing", "contradicted"],
                "description": "Coverage status."
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "description": "Evidence supporting the status."
              }
            }
          }
        },
        "result": {
          "$ref": "#/definitions/validationResult"
        }
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cross-language semantic parity check.",
      "required": ["result"],
      "properties": {
        "differences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["concept", "languages", "description"],
            "properties": {
              "concept": { "type": "string", "minLength": 1 },
              "languages": {
                "type": "array",
                "items": { "type": "string" }
              },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "result": {
          "$ref": "#/definitions/validationResult"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "description": "Link validation results.",
      "required": ["checked", "result"],
      "properties": {
        "checked": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "protected", "status"],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "Link URL."
              },
              "protected": {
                "type": "boolean",
                "description": "Whether this is a protected link."
              },
              "status": {
                "type": "string",
                "enum": ["valid", "broken", "changed"],
                "description": "Link status."
              }
            }
          }
        },
        "result": {
          "$ref": "#/definitions/validationResult"
        }
      }
    },
    "protectedTechnicalDiff": {
      "type": "object",
      "additionalProperties": false,
      "description": "Differences in protected technical content between Stage 9 and the editorial output.",
      "required": ["differences", "result"],
      "properties": {
        "differences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["itemId", "type", "before", "after"],
            "properties": {
              "itemId": { "type": "string", "minLength": 1 },
              "type": {
                "type": "string",
                "enum": ["token", "claim", "command", "link"],
                "description": "Type of protected item that differs."
              },
              "before": { "type": "string" },
              "after": { "type": "string" }
            }
          }
        },
        "result": {
          "$ref": "#/definitions/validationResult"
        }
      }
    },
    "semanticPackageFidelity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Whether the editorial output preserves the semantic content package structure.",
      "required": ["result"],
      "properties": {
        "divergences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sectionRole", "description"],
            "properties": {
              "sectionRole": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "result": {
          "$ref": "#/definitions/validationResult"
        }
      }
    },
    "idempotence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Whether a second run over the same inputs produces no diff.",
      "required": ["secondRunDiffCount", "result"],
      "properties": {
        "secondRunDiffCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of differences found in a second run."
        },
        "result": {
          "$ref": "#/definitions/validationResult"
        }
      }
    },
    "overallResult": {
      "type": "string",
      "enum": ["pass", "fail"],
      "description": "Overall post-editorial validation result."
    },
    "publicationReady": {
      "type": "boolean",
      "description": "Whether the output is ready for publication. False when any check fails or the run is draft-only."
    },
    "blockingReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Reasons blocking publication readiness."
    }
  }
}
